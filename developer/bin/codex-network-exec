#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Usage: codex-network-exec <repo-dir> <prompt-file> [extra codex exec args...]" >&2
  exit 2
fi

repo_dir="$1"
prompt_file="$2"
shift 2

if [ "$(git -C "$repo_dir" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]; then
  echo "codex-network-exec: repo-dir must be a git repository: $repo_dir" >&2
  exit 2
fi
repo_dir="$(git -C "$repo_dir" rev-parse --show-toplevel)"

if [ ! -f "$prompt_file" ]; then
  echo "codex-network-exec: prompt file not found: $prompt_file" >&2
  exit 2
fi

export CODEX_HOME="${CODEX_HOME:-${HOME}/.codex}"

exec codex --ask-for-approval never exec \
  --sandbox danger-full-access \
  -C "$repo_dir" \
  "$@" \
  - < "$prompt_file"
