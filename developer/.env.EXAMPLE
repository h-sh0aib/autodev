# Source-distribution default (the setup wizard can replace it):
# model.provider=openrouter, model.default=xiaomi/mimo-v2.5-pro.
# Leave blank only if you reconfigure the profile to another provider.
OPENROUTER_API_KEY=

# Optional API-key alternative for Anthropic. Leave blank for supported
# Claude subscription OAuth configured through the setup wizard.
ANTHROPIC_API_KEY=

# Optional: GitHub issues, branches, PRs, CI, and review comments.
GITHUB_TOKEN=

# Optional: GitLab issues, branches, merge requests, CI, and review comments.
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com

# Optional: set only when Codex auth lives outside the server account's ~/.codex.
# When blank, codex-network-exec defaults to ${HOME}/.codex.
CODEX_HOME=

# Optional: use API-key Codex on headless servers if you do not use Codex OAuth.
OPENAI_API_KEY=

# Optional: verbose LLM logging for tuning autonomous runs.
# Be careful: output logs can contain sensitive project data.
HERMES_LOG_LLM_OUTPUTS=0
HERMES_LLM_OUTPUT_LOG_MAX_CHARS=20000
