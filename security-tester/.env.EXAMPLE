# Source-distribution default: OpenRouter with moonshotai/kimi-k3.
# The setup wizard can replace this with OpenAI Codex subscription OAuth,
# Claude subscription OAuth, or another explicitly selected model.
OPENROUTER_API_KEY=

# Optional API-key alternative for Anthropic. Leave blank for supported
# Claude subscription OAuth configured through the setup wizard.
ANTHROPIC_API_KEY=

# Optional: read PRs and create security findings/remediation issues.
GITHUB_TOKEN=

# Optional: read GitLab MRs and create restricted findings/remediation issues.
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com

# Optional: verbose LLM logging for tuning autonomous runs.
# Security output can contain sensitive implementation details. Keep this off
# unless the log location and access controls have been reviewed.
HERMES_LOG_LLM_OUTPUTS=0
HERMES_LLM_OUTPUT_LOG_MAX_CHARS=20000
