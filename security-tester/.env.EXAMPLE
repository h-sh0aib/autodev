# Model provider for this profile:
# model.provider=openrouter, model.default=moonshotai/kimi-k3.
OPENROUTER_API_KEY=

# Optional: read PRs and create security findings/remediation issues.
GITHUB_TOKEN=

# Optional: verbose LLM logging for tuning autonomous runs.
# Security output can contain sensitive implementation details. Keep this off
# unless the log location and access controls have been reviewed.
HERMES_LOG_LLM_OUTPUTS=0
HERMES_LLM_OUTPUT_LOG_MAX_CHARS=20000
