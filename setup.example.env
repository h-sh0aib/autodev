# Copy this file to client.env and fill values for non-interactive installs:
#
#   ./wizard.sh --config client.env --non-interactive
#
# Leave optional values blank.

# Installer behavior
HERMES_AUTODEV_INSTALL_HERMES=1
HERMES_AUTODEV_FORCE_PROFILE_INSTALL=1

# Profile model provider
OPENROUTER_API_KEY=

# GitHub integration
GITHUB_TOKEN=
HERMES_AUTODEV_AUTH_GH=0

# Git identity for commits made from this VPS
HERMES_AUTODEV_CONFIGURE_GIT=1
GIT_USER_NAME=
GIT_USER_EMAIL=

# Codex credentials. Prefer OPENAI_API_KEY for headless client VPSes.
OPENAI_API_KEY=
CODEX_HOME=
HERMES_AUTODEV_VERIFY_CODEX=0

# Owner messaging. Telegram is optional, but useful for the PM gateway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
SIGNAL_HTTP_URL=
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=

# First project bootstrap. Set to 1 after filling repo/path values.
HERMES_AUTODEV_BOOTSTRAP_PROJECT=0
HERMES_AUTODEV_REPO_URL=
HERMES_AUTODEV_PROJECT_PATH=
HERMES_AUTODEV_PROJECT_SLUG=
HERMES_AUTODEV_PROJECT_NAME=
HERMES_AUTODEV_PROJECT_DESCRIPTION=
HERMES_AUTODEV_DELIVER=local
HERMES_AUTODEV_CREATE_CRON=1
HERMES_AUTODEV_START_GATEWAY=1

# Final checks
HERMES_AUTODEV_RUN_DOCTOR=1
