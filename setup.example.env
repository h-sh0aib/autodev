# Copy this file to client.env and fill values for non-interactive installs:
#
#   bash ./wizard.sh --config client.env --non-interactive
#
# Leave optional values blank.

# Installer behavior
HERMES_AUTODEV_INSTALL_HERMES=1
# "auto" updates Hermes only when the installed release is too old for this package.
# Use 1 to update on every wizard run, or 0 to leave an existing release alone.
HERMES_AUTODEV_UPDATE_HERMES=auto
# A forced profile reset can overwrite package-owned config. Preservation is the safe default.
HERMES_AUTODEV_FORCE_PROFILE_INSTALL=0

# Hermes orchestration model. Supported wizard providers:
#   openrouter      API key billing
#   openai-codex    ChatGPT/Codex OAuth (tier/quota semantics are provider-defined)
#   anthropic       Claude Max OAuth (requires extra-usage credits) or API key
# Use "keep" to preserve already-installed per-profile model settings.
HERMES_AUTODEV_MODEL_PROVIDER=openrouter
# Leave model IDs blank to use provider-aware defaults. Set explicit IDs only
# when you have confirmed that the selected account/provider exposes them.
HERMES_AUTODEV_HERMES_MODEL=
HERMES_AUTODEV_SECURITY_MODEL=
# OAuth is interactive, so unattended provisioning must leave this at 0.
# If the selected provider has no API key or existing auth, also defer the
# final doctor below, complete the printed per-profile logins, then run doctor.
HERMES_AUTODEV_AUTH_HERMES_SUBSCRIPTION=0
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Repository-host integration. "auto" detects each project remote and allows
# GitHub and GitLab projects on the same VPS. Other values: github, gitlab,
# both, none.
HERMES_AUTODEV_SCM_PROVIDER=auto
GITHUB_TOKEN=
HERMES_AUTODEV_AUTH_GH=0
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com
HERMES_AUTODEV_AUTH_GLAB=0

# Git identity for commits made from this VPS
HERMES_AUTODEV_CONFIGURE_GIT=1
GIT_USER_NAME=
GIT_USER_EMAIL=

# Codex implementation-worker credentials. A Codex subscription can use
# `codex login`; OPENAI_API_KEY is the separate usage-billed alternative.
OPENAI_API_KEY=
CODEX_HOME=
HERMES_AUTODEV_INSTALL_CODEX=1
HERMES_AUTODEV_AUTH_CODEX=1
HERMES_AUTODEV_VERIFY_CODEX=0

# Owner messaging. Telegram is optional, but useful for the PM gateway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
SIGNAL_HTTP_URL=
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=

# First project bootstrap. Set to 1 after filling repo/path values.
HERMES_AUTODEV_BOOTSTRAP_PROJECT=0
HERMES_AUTODEV_REPO_URL=
HERMES_AUTODEV_PROJECT_PATH=
HERMES_AUTODEV_PROJECT_SLUG=
HERMES_AUTODEV_PROJECT_NAME=
HERMES_AUTODEV_PROJECT_DESCRIPTION=
HERMES_AUTODEV_DELIVER=local
HERMES_AUTODEV_CREATE_CRON=1
HERMES_AUTODEV_START_GATEWAY=1

# Browser GUI. "auto" selects local or SSH-tunnel mode from the environment.
# The dashboard always binds to loopback; it is never exposed directly to the internet.
HERMES_AUTODEV_GUI_MODE=auto
HERMES_AUTODEV_GUI_PORT=9119
HERMES_AUTODEV_GUI_PERSIST=1
# Keep this at 0 for unattended setup, then use
# `hermes-autodev dashboard open` when ready.
HERMES_AUTODEV_GUI_START=0

# Optional public HTTPS support website and private team workspace.
# Requires a Linux systemd user session. Configure DNS/Caddy after setup.
# Noninteractive setup does not create an owner account; run
# `hermes-autodev portal user owner` before using team controls.
HERMES_AUTODEV_SETUP_PORTAL=0
AUTODEV_PORTAL_DOMAIN=

# Final checks. Set to 0 only for a deliberately staged install whose OAuth or
# CLI login will be completed afterward; always run `hermes-autodev doctor`
# before assigning work.
HERMES_AUTODEV_RUN_DOCTOR=1
