# Model provider for the default config:
# model.provider=openrouter, model.default=xiaomi/mimo-v2.5-pro.
# Leave blank only if you reconfigure the profile to another provider.
OPENROUTER_API_KEY=

# Optional: expose only the Project Manager through Telegram.
TELEGRAM_BOT_TOKEN=

# Optional but strongly recommended for Telegram: numeric user ID(s), comma-separated.
# You can also use Hermes DM pairing instead of filling this upfront.
TELEGRAM_ALLOWED_USERS=

# Optional: GitHub issues, PRs, CI, and repo operations.
GITHUB_TOKEN=

# Optional: Signal REST bridge for owner escalation or cron delivery.
SIGNAL_HTTP_URL=
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=

# Optional: verbose LLM logging for tuning autonomous runs.
# Be careful: output logs can contain sensitive project data.
HERMES_LOG_LLM_OUTPUTS=0
HERMES_LLM_OUTPUT_LOG_MAX_CHARS=20000
