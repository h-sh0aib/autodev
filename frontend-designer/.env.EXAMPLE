# Environment variables used by the frontend-designer profile.
# Copy values into .env only if this profile needs separate credentials.

# Source-distribution default is OpenRouter; the setup wizard can replace it.
OPENROUTER_API_KEY=

# Optional API-key alternative for Anthropic. Leave blank for supported
# Claude subscription OAuth configured through the setup wizard.
ANTHROPIC_API_KEY=

# Optional: verbose LLM logging for tuning autonomous runs.
# Be careful: output logs can contain sensitive project data.
HERMES_LOG_LLM_OUTPUTS=0
HERMES_LLM_OUTPUT_LOG_MAX_CHARS=20000
